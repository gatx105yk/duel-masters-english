  "name": "BEANS",
  "url": "https://beans-duelplays.com/",
  "how": "Each day is published the following morning as a single pie-chart image. Values were read from the image; the game count is the survey’s own."
 },
 "reproduction_note": "This file is this site’s working record of its own readings, kept so that articles can be computed rather than re-read. It is not a republication of the source’s dataset: site pages quote only the few figures an article argues from, with attribution. Do not publish this file wholesale as a table.",
 "conventions": {
  "completeness": "\"full\" = every slice on that day’s chart is recorded. \"tracked\" = only the six columns this site tracked at the time, plus the leader.",
  "leading_named_deck": "Largest named slice. The survey’s unnamed bucket (その他) is excluded. null when two entries tie.",
  "families": "Entries are recorded exactly as the chart labels them. Baraghiara and Magic Tools are split across entries on some days; totals are the reader’s job, not this file’s.",
  "percentages": "As printed on the chart. Every \"full\" day sums to 100.0."
 },
